{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "API_BASE_URL": "https://u9yegyk6n2.execute-api.us-east-1.amazonaws.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "API_BASE_URL": "https://u9yegyk6n2.execute-api.us-east-1.amazonaws.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "REPLACE-ME@example.com",
        "ascAppId": "REPLACE-ME",
        "appleTeamId": "REPLACE-ME"
      },
      "android": {
        "serviceAccountKeyPath": "../secrets/play-service-account.json",
        "track": "internal"
      }
    }
  }
}
