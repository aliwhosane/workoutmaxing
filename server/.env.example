# MongoDB Atlas free tier (M0), hosted on AWS.
# Atlas → Build a Database → M0 Free → AWS → pick your region.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=workoutmaxing

# Signing key for session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=replace-me

# Apple: Settings → your app's Services ID. Google: OAuth web client id.
APPLE_CLIENT_ID=co.workoutmaxing.app
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com

PORT=8080
