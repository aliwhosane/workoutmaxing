# MongoDB Atlas free tier (M0), hosted on AWS.
# Atlas → Build a Database → M0 Free → AWS → pick your region.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=workoutmaxing

# Signing key for session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=replace-me

# Apple: your app's bundle id (or Services ID for web).
APPLE_CLIENT_ID=co.workoutmaxing.app

# Google: the **web** client id — the same value as GOOGLE_WEB_CLIENT_ID in
# mobile/.env, not the iOS or Android one. The app configures Google Sign-In
# with the web client id, which makes it the audience of every ID token the
# server has to verify, on both platforms.
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com

PORT=8080
