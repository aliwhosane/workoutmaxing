{
  "expo": {
    "name": "Workout Maxing",
    "slug": "workout-maxing",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "workoutmaxing",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#0A0A0B",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.workoutmaxing.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSHealthShareUsageDescription": "Workout Maxing reads your bodyweight so it can track your strength relative to it, and reads workouts logged elsewhere so your history is complete.",
        "NSHealthUpdateUsageDescription": "Workout Maxing saves the sessions you log here to Apple Health, so they count toward your rings and appear alongside your other activity."
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      }
    },
    "android": {
      "package": "co.workoutmaxing.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0A0A0B"
      },
      "permissions": [
        "android.permission.health.WRITE_EXERCISE",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.WRITE_WEIGHT"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-router",
      "expo-sqlite",
      "expo-image",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0B"
        }
      ],
      "expo-apple-authentication",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Workout Maxing reads your bodyweight and existing workouts so your history is complete.",
          "NSHealthUpdateUsageDescription": "Workout Maxing saves the sessions you log here to Apple Health.",
          "background": true
        }
      ],
      "react-native-health-connect"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png"
  }
}