# DynamoDB (us-east-1)
DYNAMODB_TABLE=workout_maxxing
AWS_REGION=us-east-1

# Credentials. Locally the SDK also picks these up from ~/.aws/credentials or
# `aws sso login`, in which case leave them unset. On a deployed server prefer
# an IAM role over long-lived keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Signing key for session tokens. Anyone holding it can mint a session for any
# account, so this is the one value here that is genuinely secret. The server
# refuses to start if it is missing, still "replace-me", or under 32 characters.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=replace-me

# The audience every ID token is checked against. Without it the server cannot
# tell a token minted for this app from one minted for someone else's, so a
# provider whose client id is unset is refused rather than trusted.
APPLE_CLIENT_ID=co.workoutmaxing.app

# The **web** client id — the same value as GOOGLE_WEB_CLIENT_ID in mobile/.env,
# not the iOS or Android one. The app configures Google Sign-In with the web
# client id, which makes it the audience of every ID token the server verifies.
# No client *secret* is needed: the app signs in natively and sends an ID token,
# which is verified against Google's public keys. There is no authorisation-code
# exchange, which is the only flow a secret is for.
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com

PORT=8080

# Browser origins allowed to call this API, comma-separated. Leave empty: the
# only client is the native app, which is not subject to the same-origin policy
# and sends no Origin. Set it only if a web client is ever added.
CORS_ORIGIN=
