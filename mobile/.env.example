# Sync server. On a physical device this must be your machine's LAN IP,
# not localhost — the phone resolves localhost to itself.
API_BASE_URL=http://localhost:8080

# Google Sign-In (Android + iOS).
# Google Cloud console → Credentials → OAuth 2.0 Client IDs.
#   Web client id     — also what the server verifies tokens against
#   iOS client id     — for the iOS app
#   iOS URL scheme    — the iOS client id with its dot-segments reversed,
#                       e.g. com.googleusercontent.apps.123456-abcdef
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=
