# Copy to .env and fill in. .env is gitignored.

# Sync server. On a physical device this must be your machine's LAN IP —
# the phone resolves localhost to itself, not to your Mac.
API_BASE_URL=http://localhost:8080

# ---------------------------------------------------------------- Google
# Google Cloud console → APIs & Services → Credentials → Create OAuth client ID.
# You create THREE clients; only two of them produce values used here.
#
#   1. Web application
#        → paste the client ID below as GOOGLE_WEB_CLIENT_ID
#        → the SAME value is the server's GOOGLE_CLIENT_ID, because that is
#          the audience of the ID token the app sends it
#
#   2. iOS
#        Bundle ID: co.workoutmaxing.app
#        → paste the client ID as GOOGLE_IOS_CLIENT_ID
#        → GOOGLE_IOS_URL_SCHEME is that ID with its parts reversed, i.e.
#          123456-abc.apps.googleusercontent.com
#          becomes com.googleusercontent.apps.123456-abc
#
#   3. Android
#        Package name: co.workoutmaxing.app
#        SHA-1 (debug): 5E:8F:16:06:2E:A3:CD:2C:4A:0D:54:78:76:BA:A6:F3:8C:AB:F6:25
#        → produces no value to paste. Android authorises the app by its
#          package + signing fingerprint, and still uses the *web* client id
#          above for the token audience.
#
# The debug SHA-1 above is the shared debug keystore every Expo project ships
# with — fine for development, but a release build is signed with your own
# upload key and needs a second Android client for that key's SHA-1.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=
